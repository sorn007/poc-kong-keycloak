# ===== Keycloak (KC 26 ใช้ KC_BOOTSTRAP_ADMIN_*) =====
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-poc-change-me

# ===== Postgres (เก็บข้อมูล Keycloak เท่านั้น) =====
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak-poc-change-me

# ===== Legacy JWT secrets (จำลอง token เดิมที่ Buyer/CIS ออกเองก่อน migration) =====
LEGACY_BUYER_JWT_SECRET=legacy-buyer-secret-poc
LEGACY_CIS_JWT_SECRET=legacy-cis-secret-poc

# ===== Client secret ของ partner-001 (confidential, ใช้ client_credentials) =====
PARTNER_001_CLIENT_SECRET=partner-001-secret-poc

# ===== รหัสผ่าน user ทดสอบทั้งหมดใน realm =====
TEST_USER_PASSWORD=Test1234!

# secret ของ client central-broker (Identity Brokering)
CENTRAL_BROKER_CLIENT_SECRET=central-broker-secret-poc

# CIBA (headless login pilot) — secret ของ confidential client headless-app
CIBA_CLIENT_SECRET=ciba-headless-secret-poc

# Fintech App (Embedded Login exception demo) — secret ของ confidential client fintech-web
FINTECH_CLIENT_SECRET=fintech-secret-poc

# ===== Client secrets =====
CIS_CLIENT_SECRET=cis-web-secret-poc
IDPORTAL_CLIENT_SECRET=id-portal-secret-poc

# ===== Gateway trust (Kong -> Buyer shared secret) =====
GATEWAY_SECRET=gateway-shared-secret-poc
