# @central/auth-nestjs อยู่นอกโฟลเดอร์ของ service (../../packages/auth-nestjs)
# install-links=true → ติดตั้งเป็น "สำเนาจริง" ใน node_modules แทน symlink
#   จำเป็น: ถ้าเป็น symlink, require('@nestjs/common') ของ SDK จะไปลง instance อื่น
#   ทำให้ UnauthorizedException ไม่ใช่ HttpException ของ Nest ตัวนี้ → กลายเป็น 500
install-links=true
